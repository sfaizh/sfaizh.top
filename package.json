{
  "name": "@sfaizh.top/source",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "content:build": "node tools/scripts/generate-content.mjs",
    "favicon:build": "node tools/scripts/generate-favicon.mjs",
    "predev": "npm run content:build",
    "dev": "nx dev @sfaizh.top/blog",
    "dev:api": "nx serve api",
    "prebuild": "npm run content:build",
    "build": "nx build @sfaizh.top/blog",
    "start": "next start apps/blog",
    "lint": "nx run-many -t lint",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/blog/tsconfig.json --noEmit",
    "test": "npm run test:shared && npm run test:api && npm run test:blog",
    "test:shared": "jest --config libs/shared/jest.config.ts",
    "test:api": "jest --config apps/api/jest.config.ts",
    "test:blog": "jest --config apps/blog/jest.config.ts",
    "test:watch": "jest --config apps/blog/jest.config.ts --watch",
    "e2e": "playwright test -c apps/blog-e2e/playwright.config.ts",
    "e2e:serve": "next start apps/blog -p 3000",
    "admin:hash": "node tools/scripts/hash-password.mjs",
    "db:seed": "node -r ts-node/register/transpile-only -r tsconfig-paths/register tools/scripts/seed-supabase.ts",
    "verify": "npm run content:build && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.0.1",
    "@nx/devkit": "22.2.1",
    "@nx/eslint": "22.2.1",
    "@nx/eslint-plugin": "22.2.1",
    "@nx/jest": "22.2.1",
    "@nx/js": "22.2.1",
    "@nx/next": "22.2.1",
    "@nx/playwright": "22.2.1",
    "@nx/workspace": "22.2.1",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.6",
    "babel-jest": "^30.0.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "22.2.1",
    "prettier": "^2.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
