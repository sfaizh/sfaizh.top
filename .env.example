# ─────────────────────────────────────────────────────────────────────────────
# sfaizh.top — environment
#
# Every value here is optional. With none of them set the site runs completely:
# posts are served read-only from the markdown in content/posts, and the admin
# console accepts the development password below. Each variable switches on one
# more capability.
#
# Copy to `.env.local` for local development, or paste into
# Vercel → Settings → Environment Variables for a deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin console ────────────────────────────────────────────────────────────
# Signs session tokens AND salts the password hash. Rotating it logs everyone
# out and invalidates ADMIN_PASSWORD_HASH.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Produced by: AUTH_SECRET=<secret> npm run admin:hash -- 'your password'
ADMIN_PASSWORD_HASH=

# Plaintext alternative — development only. Ignored when a hash is set, and
# refused entirely in production. Defaults to "catppuccin" locally.
# ADMIN_PASSWORD=

# How long a session lasts, in seconds. Defaults to 8 hours.
# AUTH_TTL_SECONDS=28800

# ── Supabase (post storage) ──────────────────────────────────────────────────
# Without these the site serves the markdown files read-only and the admin
# console can browse but not save. Use the *service role* key: it is only ever
# read on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Table name, if you did not use the default from supabase/schema.sql.
# SUPABASE_POSTS_TABLE=posts

# ── Vercel Blob (image uploads) ──────────────────────────────────────────────
# Created automatically when you attach a Blob store to the Vercel project.
# Without it, image upload in the editor is disabled with a clear message.
BLOB_READ_WRITE_TOKEN=

# Path prefix inside the blob store. Defaults to "blog".
# BLOB_PREFIX=blog
