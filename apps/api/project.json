{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/api/src/main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json",
          "TS_NODE_TRANSPILE_ONLY": "true"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/api/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/api/jest.config.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["scope:api", "type:app"]
}
